# ============================================================
# 主动式情感陪伴系统 Agent —— 环境变量模板
# 复制本文件为 .env 并填写实际值（.env 不会提交到 Git）
# 程序启动时会自动加载本目录/上级目录的 .env 文件
# ============================================================

# ---------------- LLM 大模型（OpenAI 兼容接口） ----------------
# 默认使用 DeepSeek；任何 OpenAI 兼容服务（通义千问/Kimi/Ollama等）均可
LLM_MODEL_ID=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_PROVIDER=auto
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# 说明1: Key 变量名兼容多种写法，以下任一种都会被自动识别:
#   LLM_API_KEY / DEEPSEEK_API_KEY / OPENAI_API_KEY / DASHSCOPE_API_KEY
#   / QWEN_API_KEY / MOONSHOT_API_KEY / KIMI_API_KEY / ZHIPU_API_KEY / API_KEY
# 说明2: 模型名要与你的服务商一致，常见选择:
#   DeepSeek: deepseek-chat / deepseek-flash / deepseek-reasoner
#   通义千问: qwen-plus / qwen-turbo
#   Kimi:     moonshot-v1-8k / moonshot-v1-32k
#   本地:     Ollama 填 http://localhost:11434/v1 + 任意模型名(如 qwen2.5:7b)
# 说明3: 不填 Key → 自动进入离线演示模式（内置共情话术脑），零费用可跑通闭环。

# ---------------- TTS 语音合成（Edge-TTS 免费方案） -------------
TTS_ENABLED=0
TTS_VOICE=zh-CN-XiaoyiNeural

# ---------------- 算法层 ----------------
# 旧HRV模型只用于显式模拟/演示，不用于新硬件生产分类。
ML_MODEL_PATH=models/emotion_model_rf.joblib
MULTIMODAL_MODEL_ENABLED=0
MULTIMODAL_MODEL_PATH=models/multimodal_emotion.joblib
EMOTION_CONFIRM_SEC=10

# ---------------- 记忆层 ----------------
# 向量检索（ChromaDB）开关；关闭时使用 SQLite 关键词检索
CHROMA_ENABLED=0

# Online frontend allowed origins, comma-separated, no repository path
WEB_ALLOWED_ORIGINS=https://doc-b-yang.github.io
